# ---------------------------------------------------------------------------
# Vaagdegi Colleges - Backend Environment Configuration
# Copy this file to .env and fill in real values before running the server.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vaagdegi_portal?schema=public"

# JWT secrets - generate strong random values in production, e.g.:
#   openssl rand -base64 48
JWT_ACCESS_SECRET="change-this-super-secret-access-key"
JWT_REFRESH_SECRET="change-this-super-secret-refresh-key"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS - frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:5173

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Security
BCRYPT_SALT_ROUNDS=10
